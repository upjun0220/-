#!/bin/sh
# ══════════════════════════════════════════════════════════════════
# pre-commit — 코드를 고쳤으면 인계 노트도 남기게 강제한다
#
#   Claude Code 와 Cowork 는 기억을 공유하지 않는다. HANDOFF.md 를 안 남기면
#   다음 세션의 반대쪽이 아무것도 모르는 채로 문서를 쓰고, 그게 그대로
#   README·보고서에 들어간다. 그래서 커밋 시점에 막는다.
#
#   설치 (내 PC PowerShell):
#       cd "C:\Users\82102\OneDrive\문서\Claude\Projects\공모전"
#       git config core.hooksPath .githooks
#
#   해제:  git config --unset core.hooksPath
#   1회 우회: git commit --no-verify -m "..."
# ══════════════════════════════════════════════════════════════════

STAGED=$(git diff --cached --name-only)

# ── ① 형태 검사 — HANDOFF / AI_BRIDGE 가 스테이징됐으면 반드시 통과해야 한다
#    ⚠ [8/03] 검사기가 있어도 안 돌리면 의미가 없다. 40줄을 넘고 완료 기록이
#      가득해도 그냥 커밋되던 상태였다. 여기서 막는다.
if printf '%s\n' "$STAGED" | grep -qE '^(HANDOFF\.md|04_문서/AI_BRIDGE/)'; then
    PY=$(command -v python || command -v python3)
    if [ -n "$PY" ]; then
        "$PY" scripts/validate_handoff.py   || exit 1
        "$PY" scripts/validate_ai_bridge.py || exit 1
    fi
fi

# ── ①-b 규칙 문서 동기 — CLAUDE.md/.claude 를 고쳤으면 AGENTS.md/.agents 도 같이 간다
#    ⚠ [8/04] 손으로 두 벌을 고치다 실제로 갈라졌다. AGENTS.md 의 인계 규칙이
#      이미 없어진 §0/§1/§2 구조를 지시하고 있었다(session-end 스킬은 74줄 차이).
#      Claude Code 와 Codex 가 다른 규칙으로 움직이면 반대쪽이 틀린 문서를 쓴다.
if printf '%s\n' "$STAGED" | grep -qE '^(CLAUDE\.md|AGENTS\.md|\.claude/skills/|\.agents/skills/)'; then
    PY=$(command -v python || command -v python3)
    if [ -n "$PY" ]; then
        "$PY" scripts/sync_agent_docs.py --check || exit 1
    fi
fi

# ── ② 판정/화면 코드가 스테이징됐는가
CODE=$(printf '%s\n' "$STAGED" | grep -E '^01_현행코드/.*\.py$' || true)
[ -z "$CODE" ] && exit 0

# HANDOFF.md 도 같이 스테이징됐는가
printf '%s\n' "$STAGED" | grep -qx 'HANDOFF.md' && exit 0

cat <<'MSG' >&2

  ┌──────────────────────────────────────────────────────────────┐
  │  커밋을 멈췄습니다 — HANDOFF.md 가 갱신되지 않았습니다        │
  └──────────────────────────────────────────────────────────────┘

  01_현행코드/ 의 .py 를 고쳤는데 인계 노트가 그대로입니다.
  Claude Code 와 Cowork 는 기억을 공유하지 않으므로, 여기에
  남기지 않으면 다음 세션의 반대쪽은 이 작업을 모릅니다.

  HANDOFF.md 에 쓸 것 (§2):
    · 검증 결과 숫자        예) "레이아웃 4해상도 0건"
    · 막힌 것 · 판단이 필요한 갈림길
    · §1 지시와 다르게 한 것과 그 이유   ← 가장 중요
    · 다음에 이어서 할 것

  쓰지 말 것: 파일별 변경 내역 (그건 git diff 가 정본)

  ── 다음 중 하나 ─────────────────────────────────────────────
    1) HANDOFF.md 를 고치고  git add HANDOFF.md  후 다시 커밋
    2) Claude Code 에서:  session-end 스킬로 마무리해줘
    3) 이번만 건너뛰기:   git commit --no-verify -m "..."

MSG
exit 1
